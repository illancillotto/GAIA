GAIA_MCP_OAUTH_ENABLED=false
GAIA_MCP_OAUTH_ISSUER=https://gaia.lan/api/wiki/mcp/connector/oauth
GAIA_MCP_OAUTH_RESOURCE=https://gaia.lan/api/wiki/mcp/connector/data
GAIA_MCP_OAUTH_CONSENT_URL=https://gaia.lan/mcp/consent
GAIA_MCP_OAUTH_CLIENTS_FILE=/mcp-config/approved-clients.json
GAIA_MCP_OAUTH_DATABASE=/mcp-oauth/gaia-mcp-oauth.sqlite
GAIA_MCP_CONNECTOR_DATA_DATABASE=/mcp-data/gaia-mcp-synthetic-v1.sqlite
GAIA_MCP_CONNECTOR_AUDIT_DATABASE=/mcp-audit/gaia-mcp-audit.sqlite
GAIA_MCP_OAUTH_SESSION_SECONDS=28800
GAIA_MCP_OAUTH_CLEANUP_SECONDS=60
GAIA_MCP_OAUTH_MAX_GRANTS=10000
GAIA_MCP_OAUTH_MAX_CLIENT_GRANTS=1000
GAIA_MCP_CONNECTOR_REQUESTS_PER_MINUTE=60
GAIA_MCP_CONNECTOR_TOOLS_PER_MINUTE=20
