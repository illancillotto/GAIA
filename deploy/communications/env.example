# Copy outside Git. Replace these synthetic placeholders only in an authorized environment.
COMMUNICATIONS_DATABASE_URL=postgresql+psycopg://communications_worker:REPLACE@postgres/gaia
COMMUNICATIONS_INTERNAL_KEY=REPLACE_WITH_RANDOM_INTERNAL_VALUE
COMMUNICATIONS_TRANSPORT_ENABLED=false
COMMUNICATIONS_SECRETS_PATH=./secrets/communications
COMMUNICATIONS_TRUST_PATH=./secrets/communications-trust
COMMUNICATIONS_PEC_SIGNER_SHA256=
COMMUNICATIONS_NAS_HOST=
COMMUNICATIONS_NAS_PORT=22
COMMUNICATIONS_NAS_USERNAME=
# Optional read-only NAS identity, stored in the same private secret mount:
COMMUNICATIONS_NAS_KEY_PATH=
# Paths are relative to the FIRST Compose file (repository root for docker-compose.yml).
